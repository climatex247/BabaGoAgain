PORT=5000
APP_BASE_URL=http://127.0.0.1:5000
CORS_ORIGIN=http://127.0.0.1:5000
BREVO_API_KEY=replace_with_your_key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Baba Go Again

# ImageKit media storage. Keep the private key server-side only.
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
SESSION_SECRET=replace_with_a_long_random_secret_before_public_deployment
COOKIE_SECURE=false

# Volunteer wallet security and OPay transfers. Keep all keys server-side.
WALLET_ENCRYPTION_KEY=replace_with_a_random_secret_at_least_32_characters_long
BGA_ADMIN_EMAILS=your-verified-admin-email@example.com
OPAY_PAYOUT_ENABLED=false
OPAY_BASE_URL=https://sandbox-cashierapi.opayweb.com
OPAY_MERCHANT_ID=replace_with_opay_merchant_id
OPAY_PRIVATE_KEY=replace_with_opay_private_key
